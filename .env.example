# ==========================================
# KisanDr Environment Variables for Vercel
# ==========================================

# Required: Google Gemini API Key for crop pathology analysis and voice assistant.
# Obtain a free key from https://aistudio.google.com/app/apikey
# On Vercel: Add this in Project Settings > Environment Variables > GEMINI_API_KEY
GEMINI_API_KEY="your_api_key_here"

# Optional: Port for local Node.js development server (default: 3000)
PORT=3000
